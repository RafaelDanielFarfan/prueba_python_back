# Copia este archivo como .env y ajusta los valores.
APP_NAME="Implicit Volumes API"
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# PostgreSQL (docker/compose.yml)
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=YOUR_DB_NAME
POSTGRES_TEST_DB=YOUR_TEST_DB_NAME
POSTGRES_PORT=5432

APP_DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME
APP_TEST_DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_TEST_DB_NAME
APP_DATABASE_ECHO=false

# Autenticación (genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=YOUR_SECRET_KEY
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Funciones implícitas
APP_DEFAULT_RESOLUTION=64
APP_MIN_RESOLUTION=8
APP_MAX_RESOLUTION=256
APP_MAX_EXPRESSION_LENGTH=500
APP_MAX_CONCURRENT_COMPUTATIONS=2

# Cache de resultados
APP_CACHE_MAX_ITEMS=128
